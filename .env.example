# Copy to .env (Dockge: paste into the stack's .env editor). Never commit the real one.

# --- Required ---------------------------------------------------------------------------------
# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=
# warcraftlogs.com/api/clients -> Create Client (redirect URL: http://localhost, unused)
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# --- Discord -----------------------------------------------------------------------------------
# IDs: Discord Settings -> Advanced -> Developer Mode on, then right-click -> Copy ID.
# Channel(s) where log links get posted. Comma-separated. Empty = only /recap works.
WATCH_CHANNEL_IDS=
# Your server's ID. Makes slash commands appear instantly (otherwise up to an hour).
DISCORD_GUILD_ID=
# Role allowed to /link characters for other people. Server managers always can.
OFFICER_ROLE_ID=
# Realm to assume when someone runs /link without one and the bot hasn't seen the character yet.
DEFAULT_REALM=
# The guild's timezone, for the date in thread titles (e.g. America/Chicago, Europe/London).
TIMEZONE=UTC
# false = the parse leaderboard in the thread doesn't ping the whole raid (award winners still are).
THREAD_PING_EVERYONE=true

# --- Recap tuning (defaults shown) -------------------------------------------------------------
PARSE_HIGH=90
PARSE_GREY=25
GREY_INCLUDE_TANKS=false
# Deaths after this many in one pull don't count (the wipe was already called).
WIPE_CUTOFF=5
DEATHS_TOP_N=3
DEATHS_INCLUDE_TRASH=false
# Which parse number to use. Empty = WCL's API default, which matched "Rankings" on every log tested.
# WCL_COMPARE: Rankings (vs best of the tier) or Parses (vs the last two weeks, usually higher)
# WCL_TIMEFRAME: Today or Historical. Historical returns nothing for current-tier logs; leave empty.
WCL_COMPARE=
WCL_TIMEFRAME=

# Not needed: one WCL client works on every site (retail, classic, fresh, vanilla).
# Only if you ever want a separate client per site:
# WCL_CLIENT_ID_CLASSIC=
# WCL_CLIENT_SECRET_CLASSIC=
